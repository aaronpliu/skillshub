# =============================================================================
# Enterprise Skills Hub - Environment Configuration
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Enterprise Skills Hub
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://skills:skills_dev@localhost:5432/skills_hub?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication / SSO
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production-min-32-chars!!
SSO_ISSUER=https://idp.acme.com
SSO_CLIENT_ID=skills-hub
SSO_CLIENT_SECRET=dev-client-secret
SSO_AUTHORIZATION_ENDPOINT=https://idp.acme.com/authorize
SSO_TOKEN_ENDPOINT=https://idp.acme.com/oauth/token
SSO_USERINFO_ENDPOINT=https://idp.acme.com/userinfo
SSO_JWKS_URI=https://idp.acme.com/.well-known/jwks.json

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars!!
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# S3 / MinIO (Object Storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=skills-hub
S3_REGION=us-east-1
S3_AUDIT_BUCKET=skills-hub-audit

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=skills

# Encryption (L4 Security)
ENCRYPTION_KEY=dev-encryption-key-32-chars-min!!

# Audit Log HMAC Key
AUDIT_HMAC_KEY=dev-audit-hmac-key-change-in-prod!!

# Email (SES / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@skills.acme.com

# Slack Integration (optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#skills-hub

# Rate Limiting
RATE_LIMIT_GLOBAL_RPM=1000
RATE_LIMIT_GLOBAL_RPH=10000

# Feature Flags
NEXT_PUBLIC_ENABLE_ELASTICSEARCH=false
NEXT_PUBLIC_ENABLE_SLACK=false
NEXT_PUBLIC_ENABLE_DLP_SCAN=true
NEXT_PUBLIC_ENABLE_SECURITY_SCAN=true
